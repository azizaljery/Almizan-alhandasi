{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "src/planner.mjs",
    "src/estimates.mjs",
    "src/PlannerOutputContract.mjs",
    "src/migrations.mjs",
    "src/compat-layer.mjs"
  ]
}
