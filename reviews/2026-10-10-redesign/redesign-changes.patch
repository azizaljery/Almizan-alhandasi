diff --git a/dist/plot-entry.mjs b/dist/plot-entry.mjs
new file mode 100644
index 0000000..9f3e1c1
--- /dev/null
+++ b/dist/plot-entry.mjs
@@ -0,0 +1,67 @@
+import { DIRECTIONS, validatePlot } from './planner.mjs';
+
+export function streetsForEntry(currentStreets, entry, streetSelectionExplicit = false) {
+  const current = Object.fromEntries(Object.keys(DIRECTIONS).map(side => [side, currentStreets?.[side] === true]));
+  if (!streetSelectionExplicit) {
+    return Object.fromEntries(Object.keys(DIRECTIONS).map(side => [side, side === entry]));
+  }
+  if (Object.hasOwn(current, entry)) current[entry] = true;
+  return current;
+}
+
+// Build and validate an entry-side change without mutating the caller's plot.
+// Fresh UI frontage is a default that follows the selected entry. Once the user
+// explicitly edits advanced frontage, retain those sides and add the entrance.
+export function validateEntryPlot(raw, entry, {
+  currentStreets = raw?.streets,
+  streetSelectionExplicit = false,
+  surveyBinding = null,
+} = {}) {
+  const candidate = validatePlot({
+    ...raw,
+    entry,
+    streets: streetsForEntry(currentStreets, entry, streetSelectionExplicit),
+  });
+  if (surveyBinding && (
+    Math.abs(candidate.width - surveyBinding.width) > 1e-8 ||
+    Math.abs(candidate.length - surveyBinding.length) > 1e-8
+  )) {
+    throw Error('أبعاد مستطيل المولد مرتبطة بالمسح المحفوظ؛ أعد الربط أو اختر مستطيلًا منفصلًا صراحةً قبل تغييرها.');
+  }
+  return candidate;
+}
+
+// The app injects its DOM callbacks, while tests supply small state/field stubs.
+// All validation (including the explicit survey binding) finishes before any
+// callback or state write, so rejected input leaves the UI and street vector intact.
+export function setPlotFromSimpleInput({
+  state,
+  input,
+  getRawPlot,
+  getSurveyBinding = () => null,
+  commitFields,
+  renderStreets = () => {},
+  rating = () => {},
+  markDirty = () => {},
+}) {
+  const { width, length, entry, maxBuiltArea } = input || {};
+  if (!['s', 'n', 'e', 'w'].includes(entry)) throw Error('جهة المدخل غير صالحة.');
+  const requested = {
+    ...getRawPlot(),
+    width: Number(width),
+    length: Number(length),
+    entry,
+    maxBuiltArea: maxBuiltArea === null || maxBuiltArea === undefined || maxBuiltArea === '' ? null : Number(maxBuiltArea),
+  };
+  const candidate = validateEntryPlot(requested, entry, {
+    currentStreets: state.streets,
+    streetSelectionExplicit: state.streetSelectionExplicit,
+    surveyBinding: getSurveyBinding(),
+  });
+  commitFields(candidate);
+  state.streets = { ...candidate.streets };
+  renderStreets();
+  rating();
+  markDirty();
+  return candidate;
+}
