diff --git a/tests/brief-topology-generation.test.mjs b/tests/brief-topology-generation.test.mjs
new file mode 100644
index 0000000..e3ec49e
--- /dev/null
+++ b/tests/brief-topology-generation.test.mjs
@@ -0,0 +1,174 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { generateBriefTopologyModel } from '../dist/brief-topology-planner.mjs';
+import { runMultiEngineDesign } from '../dist/multi-engine.mjs';
+import { generateModelLegacy } from '../dist/claude/compat-layer.mjs';
+import { validateModel, validatePlot, quantities } from '../dist/planner.mjs';
+import { circulationNetwork } from '../dist/circulation.mjs';
+import { TYPES } from '../dist/claude/planner.mjs';
+
+const plot = validatePlot({ width: 20, length: 30, floors: 1, entry: 's', streets: { s: true },
+  streetSetback: 3, neighborSetback: 1.5, coverage: .75 });
+const exactBrief = [
+  { name: 'غرفة نوم 1', type: 'bedroom', area: 16, dimensions: { width: 4, length: 4 }, position: 'back', side: 'any' },
+  { name: 'غرفة نوم 2', type: 'bedroom', area: 16, dimensions: { width: 4, length: 4 }, position: 'back', side: 'any' },
+  { name: 'غرفة نوم 3', type: 'bedroom', area: 16, dimensions: { width: 4, length: 4 }, position: 'back', side: 'any' },
+  { name: 'صالة عائلية', type: 'living', area: 30, dimensions: { width: 6, length: 5 }, position: 'middle', side: 'any' },
+  { name: 'مطبخ', type: 'kitchen', area: 48, dimensions: { width: 8, length: 6 }, position: 'middle', side: 'any' },
+];
+const occupied = m => m.rooms.filter(r => ['bedroom', 'living', 'majlis', 'dining'].includes(r.type));
+const measures = m => {
+  const q = quantities(m), route = circulationNetwork(m);
+  return { gross: q.footprint, corridors: q.circulation, reserve: q.reserve,
+    longest: Math.max(...m.rooms.map(r => route.toRoom(r.id)?.metres ?? Infinity)),
+    windowedOccupied: occupied(m).filter(r => m.openings.some(o => o.roomId === r.id && o.type === 'window')).length,
+    occupied: occupied(m).length };
+};
+
+test('compact brief topology is an ordinary reviewed candidate and beats exact-brief baseline axes', async () => {
+  const baseline = generateModelLegacy(plot, exactBrief, { strategy: 'compact', allowFallback: false });
+  const model = generateBriefTopologyModel(plot, exactBrief, { variant: 2 });
+  assert.deepEqual(validateModel(model), []);
+  assert.equal(model.rooms.length, exactBrief.length);
+  assert.equal(model.shape, 'rect'); // true rectangular perimeter; novelty is the actual room/corridor topology
+  for (const requested of exactBrief) {
+    const actual = model.rooms.find(r => r.name === requested.name);
+    assert.ok(actual); assert.ok(Math.abs(actual.w * actual.h - requested.area) < 1e-8);
+    assert.ok(Math.abs(actual.w - requested.dimensions.width) < 1e-5 && Math.abs(actual.h - requested.dimensions.length) < 1e-5
+      || Math.abs(actual.w - requested.dimensions.length) < 1e-5 && Math.abs(actual.h - requested.dimensions.width) < 1e-5);
+    assert.ok(circulationNetwork(model).toRoom(actual.id));
+  }
+  const old = measures(baseline), next = measures(model);
+  assert.ok(next.gross < old.gross - 1);
+  assert.ok(next.corridors < old.corridors - 1);
+  assert.ok(next.longest < old.longest - 1);
+  assert.equal(next.windowedOccupied, next.occupied);
+
+  const result = await runMultiEngineDesign({ plot, rooms: exactBrief, idea: 'توزيع مدمج بلا فناء داخلي', seed: 17 });
+  const generated = result.models.filter(m => m.integration.alternativeKey.startsWith('brief-spine-'));
+  assert.ok(generated.length > 0, 'candidate participates in ordinary unspecified-shape review/selection');
+  assert.ok(generated.every(m => validateModel(m).length === 0));
+  assert.ok(generated.some(m => m.integration.candidateId === result.selectedModel.integration.candidateId));
+  assert.ok(result.reviews.every(r => r.checks.find(c => c.id === 'program-areas')?.status === 'PASS'));
+  const source = createHash('sha256').update(readFileSync('dist/brief-topology-planner.mjs')).digest('hex');
+  assert.ok(generated.every(m => m.integration.candidateId));
+  const request = await (await import('../dist/multi-engine.mjs')).buildDesignRequest({ plot, rooms: exactBrief, idea: 'توزيع مدمج بلا فناء داخلي' });
+  const { candidate } = await (await import('../dist/integration/pipeline.mjs')).generateCandidate(request, 'rect', {},
+    { shape: 'rect', key: 'brief-spine-provenance', seed: 17, topology: 'brief-spine', variant: 2 });
+  assert.equal(candidate.producer.engineId, '@mizan/brief-topology-composer');
+  assert.equal(candidate.producer.sourceSha256, source);
+});
+
+test('brief topology preserves either built-area cap alias and fails closed on low, invalid, or conflicting caps', async () => {
+  for (const capField of ['maxBuiltAreaM2', 'maxBuiltArea']) {
+    const accepted = generateBriefTopologyModel({ ...plot, [capField]: 250 }, exactBrief, { variant: 2 });
+    assert.equal(accepted.plot.maxBuiltArea, 250);
+    assert.throws(() => generateBriefTopologyModel({ ...plot, [capField]: 200 }, exactBrief, { variant: 2 }),
+      /BRIEF_TOPOLOGY_MAX_BUILT_AREA_EXCEEDED/);
+  }
+  for (const invalid of [0, -1, Infinity, NaN, plot.width * plot.length + 1]) {
+    assert.throws(() => generateBriefTopologyModel({ ...plot, maxBuiltAreaM2: invalid }, exactBrief),
+      /سقف البناء/);
+  }
+  assert.throws(() => generateBriefTopologyModel({ ...plot, maxBuiltArea: 230, maxBuiltAreaM2: 220 }, exactBrief),
+    /CONFLICTING_AREA_CAP/);
+  const cappedPlot = validatePlot({ ...plot, maxBuiltArea: 200 });
+  await assert.rejects(runMultiEngineDesign({ plot: cappedPlot, rooms: exactBrief, idea: 'توزيع مدمج بلا فناء داخلي', seed: 17 }),
+    /MAX_BUILT_AREA_EXCEEDED|BRIEF_TOPOLOGY_MAX_BUILT_AREA_EXCEEDED|No candidate|لم يتمكن/);
+});
+
+test('room-type minimum dimensions are enforced for six types and area-only rooms', async () => {
+  for (const type of ['bedroom', 'majlis', 'living', 'dining', 'kitchen', 'bath']) {
+    const minimum = TYPES[type].min;
+    const width = minimum, length = Math.max(minimum, 4 / minimum);
+    const atBoundary = { name: `Boundary ${type}`, type, area: width * length,
+      dimensions: { width, length }, position: 'middle', side: 'any' };
+    const accepted = generateBriefTopologyModel(plot, [atBoundary]);
+    assert.deepEqual(validateModel(accepted), [], type);
+    const below = { ...atBoundary, name: `Below ${type}`, dimensions: { width: minimum - .01, length: Math.max(minimum + .5, 4 / (minimum - .01)) } };
+    below.area = below.dimensions.width * below.dimensions.length;
+    assert.throws(() => generateBriefTopologyModel(plot, [below]), /BRIEF_TOPOLOGY_ROOM_MIN_DIMENSION_UNSATISFIED/, type);
+  }
+  const tooSmallSquareBedroom = { name: 'Tiny bedroom', type: 'bedroom', area: 2.59 ** 2,
+    position: 'middle', side: 'any' };
+  assert.throws(() => generateBriefTopologyModel(plot, [tooSmallSquareBedroom]), /BRIEF_TOPOLOGY_ROOM_MIN_DIMENSION_UNSATISFIED/);
+  const invalidExactBedroom = { name: 'Short bedroom', type: 'bedroom', area: 6,
+    dimensions: { width: 2, length: 3 }, position: 'middle', side: 'any' };
+  assert.throws(() => generateBriefTopologyModel(plot, [invalidExactBedroom]), /BRIEF_TOPOLOGY_ROOM_MIN_DIMENSION_UNSATISFIED/);
+  await assert.rejects(runMultiEngineDesign({ plot, rooms: [invalidExactBedroom], seed: 1 }),
+    /ROOM_MIN_DIMENSION|SHAPE_FIT_FAILED|No candidate|لم يتمكن/);
+});
+
+test('area-only everyday briefs receive a reviewed brief-topology alternative in ordinary generation', async () => {
+  const program = [
+    { name: 'Family living', type: 'living', area: 30, position: 'middle', side: 'any' },
+    { name: 'Kitchen', type: 'kitchen', area: 16, position: 'middle', side: 'any' },
+    { name: 'Bedroom', type: 'bedroom', area: 16, position: 'back', side: 'any' },
+    { name: 'Office', type: 'office', area: 12, position: 'front', side: 'left' },
+  ];
+  const result = await runMultiEngineDesign({ plot, rooms: program, seed: 13 });
+  const generated = result.models.filter(model => model.integration.alternativeKey.startsWith('brief-spine-'));
+  assert.ok(generated.length > 0);
+  for (const model of generated) {
+    assert.deepEqual(validateModel(model), []);
+    assert.equal(model.rooms.length, program.length);
+    assert.deepEqual(model.rooms.map(room => room.targetArea).sort((a, b) => a - b), program.map(room => room.area).sort((a, b) => a - b));
+    assert.ok(model.rooms.every(room => circulationNetwork(model).toRoom(room.id)));
+  }
+});
+
+test('room placement responds to brief zones, fixed sides, and all entry orientations', () => {
+  const changed = exactBrief.map(r => r.name === 'صالة عائلية' ? { ...r, position: 'front' } : r);
+  const south = generateBriefTopologyModel(plot, changed);
+  assert.deepEqual(validateModel(south), []);
+  assert.ok(south.rooms.find(r => r.name === 'صالة عائلية').y < south.rooms.find(r => r.name === 'مطبخ').y);
+  for (const entry of ['s', 'n', 'e', 'w']) {
+    const oriented = validatePlot({ ...plot, entry, streets: { [entry]: true } });
+    const fixed = exactBrief.map((r, i) => i === 0 ? { ...r, side: 'left' } : r);
+    const model = generateBriefTopologyModel(oriented, fixed);
+    assert.deepEqual(validateModel(model), [], entry);
+    assert.equal(model.rooms.find(r => r.id === 'room-0').resolvedSide, 'left', entry);
+    assert.ok(model.rooms.every(r => circulationNetwork(model).toRoom(r.id)), entry);
+  }
+});
+
+test('a second asymmetric brief drives front/middle/back zones independent of request order', () => {
+  const program = [
+    { name: 'Reception', type: 'living', area: 30, dimensions: { width: 6, length: 5 }, position: 'front', side: 'left' },
+    { name: 'Office', type: 'office', area: 12, dimensions: { width: 3, length: 4 }, position: 'middle', side: 'right' },
+    { name: 'Kitchen', type: 'kitchen', area: 16, dimensions: { width: 4, length: 4 }, position: 'middle', side: 'left' },
+    { name: 'Bedroom', type: 'bedroom', area: 16, dimensions: { width: 4, length: 4 }, position: 'back', side: 'right' },
+  ];
+  const signature = model => model.rooms.map(room => [room.name, room.x, room.y, room.w, room.h, room.resolvedSide]
+    .map(value => typeof value === 'number' ? value.toFixed(5) : value).join('|')).sort();
+  const first = generateBriefTopologyModel(plot, program);
+  const reversed = generateBriefTopologyModel(plot, [...program].reverse());
+  assert.deepEqual(validateModel(first), []);
+  assert.deepEqual(validateModel(reversed), []);
+  assert.deepEqual(signature(first), signature(reversed));
+  for (const requested of program) {
+    const room = first.rooms.find(item => item.name === requested.name);
+    assert.equal(room.resolvedSide, requested.side);
+    assert.ok(circulationNetwork(first).toRoom(room.id));
+  }
+  const front = first.rooms.find(room => room.name === 'Reception');
+  const middle = first.rooms.find(room => room.name === 'Office');
+  const back = first.rooms.find(room => room.name === 'Bedroom');
+  assert.ok(front.y + front.h <= middle.y + 1e-5);
+  assert.ok(middle.y + middle.h <= back.y + 1e-5);
+  const variants = [0, 1, 2].map(variant => generateBriefTopologyModel(plot, exactBrief, { variant }));
+  assert.ok(variants.every(model => validateModel(model).length === 0));
+  const signatures = new Set(variants.map(model => model.rooms.map(room => [room.name, room.x, room.y, room.w, room.h, room.resolvedSide]
+    .map(value => typeof value === 'number' ? value.toFixed(4) : value).join('|')).sort().join('::')));
+  assert.ok(signatures.size > 1, 'the bounded topology search produces distinct room arrangements');
+});
+
+test('candidate ordering and geometry are deterministic for the same seed and brief', async () => {
+  const args = { plot, rooms: exactBrief, idea: 'توزيع مدمج بلا فناء داخلي', seed: 27 };
+  const [a, b] = await Promise.all([runMultiEngineDesign(args), runMultiEngineDesign(args)]);
+  assert.deepEqual(a.models.map(m => m.integration.alternativeKey), b.models.map(m => m.integration.alternativeKey));
+  assert.deepEqual(a.models.map(m => m.integration.geometryHash.value), b.models.map(m => m.integration.geometryHash.value));
+  assert.equal(a.selectedModel.integration.candidateId, b.selectedModel.integration.candidateId);
+});
diff --git a/tests/plan-presentation.test.mjs b/tests/plan-presentation.test.mjs
new file mode 100644
index 0000000..8419cfe
--- /dev/null
+++ b/tests/plan-presentation.test.mjs
@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { defaultRooms, generateModel, validatePlot } from '../dist/planner.mjs';
+import { buildPlanSVG, planOutlineMetrics } from '../dist/plan-view.mjs';
+
+const entries = ['s', 'n', 'e', 'w'];
+const plotFor = entry => validatePlot({
+  width: 25, length: 35, floors: 1, entry,
+  streets: Object.fromEntries(entries.map(side => [side, side === entry])),
+  streetSetback: 3, neighborSetback: 1.5, coverage: .75, maxBuiltArea: null,
+});
+const designFor = entry => generateModel(plotFor(entry), defaultRooms({ bedrooms: 2, majlis: 0, baths: 1, kitchens: 1, halls: 1, dining: 0 }));
+const axisValue = (svg, axis) => svg.match(new RegExp(`<text data-axis="${axis}"[^>]*>([^<]*)</text>`))?.[1];
+
+test('outside dimensions come from exterior-wall faces and scale bar uses metre geometry', () => {
+  const model = designFor('s'), before = JSON.stringify(model), dimensions = planOutlineMetrics(model), svg = buildPlanSVG(model);
+  assert.equal(JSON.stringify(model), before, 'drawing must not mutate the measured plan');
+  assert.equal(axisValue(svg, 'east-west'), `${dimensions.width.toFixed(2)} م`);
+  assert.equal(axisValue(svg, 'north-south'), `${dimensions.length.toFixed(2)} م`);
+  assert.match(svg, /data-outline-dimensions="true" aria-label="الأبعاد الخارجية بالمتر/);
+  assert.match(svg, /data-scale-bar="true" data-segment-length-m="1"/);
+  const scalePath = svg.match(/<g data-scale-bar="true"[^>]*><path d="([^"]+)"/)?.[1];
+  assert.ok(scalePath);
+  const scaleNumbers = scalePath.match(/[+-]?(?:\d+(?:\.\d*)?|\.\d+)/g).map(Number);
+  assert.ok(Math.abs(scaleNumbers[2] - scaleNumbers[0] - 2) < 1e-6, 'the graphic scale spans two model metres');
+  assert.ok(Math.abs(scaleNumbers[6] - scaleNumbers[3] - 1) < 1e-6, 'adjacent scale ticks are one metre apart');
+  assert.match(svg, /text x="[^\"]+" y="[^\"]+" font-size="\.34"[^>]*>الدور الأرضي/);
+});
+
+test('north remains project north while the entry arrow follows each of the four actual entry sides', () => {
+  const vectors = { s: [0, 1], n: [0, -1], e: [1, 0], w: [-1, 0] };
+  for (const entry of entries) {
+    const model = designFor(entry), svg = buildPlanSVG(model);
+    assert.match(svg, new RegExp(`data-entry-indicator="${entry}" aria-label="المدخل جهة ${entry === 's' ? 'جنوب' : entry === 'n' ? 'شمال' : entry === 'e' ? 'شرق' : 'غرب'}"`));
+    assert.match(svg, /<g data-north-arrow="true" data-axis="project-north"/);
+    assert.match(svg, /<path d="M0 -\.76L-\.22 0H\.22Z"\/><path d="M0 -\.04V\.42"/);
+    const attrs = svg.match(new RegExp(`<g data-entry-indicator="${entry}"[^>]*><line ([^>]+)`))?.[1];
+    assert.ok(attrs, `${entry}: entry-direction line is present`);
+    const numbers = Object.fromEntries([...attrs.matchAll(/(x1|y1|x2|y2)="([+-]?[\d.]+)"/g)].map(([, key, value]) => [key, Number(value)]));
+    const [dx, dy] = vectors[entry];
+    assert.ok(Math.abs((numbers.x2 - numbers.x1) * dx + (numbers.y2 - numbers.y1) * dy) > .5, `${entry}: arrow points outward`);
+    assert.ok(Math.abs((numbers.x2 - numbers.x1) * dy - (numbers.y2 - numbers.y1) * dx) < 1e-6, `${entry}: arrow is normal to the facade`);
+    const bounds = planOutlineMetrics(model);
+    assert.equal(axisValue(svg, 'east-west'), `${bounds.width.toFixed(2)} م`);
+    assert.equal(axisValue(svg, 'north-south'), `${bounds.length.toFixed(2)} م`);
+  }
+});
+
+test('wall hierarchy, openings, door swings, and room selection labels remain in the SVG', () => {
+  const model = designFor('e'), svg = buildPlanSVG(model);
+  assert.equal((svg.match(/data-wall="ext"/g) || []).length, model.walls.filter(w => w.type === 'ext').length);
+  assert.equal((svg.match(/data-wall="int"/g) || []).length, model.walls.filter(w => w.type === 'int').length);
+  assert.ok(model.openings.some(o => o.type === 'window'));
+  assert.ok(model.openings.some(o => o.type === 'door'));
+  assert.ok((svg.match(/A[\d.]+ [\d.]+ 0 0 [01]/g) || []).length >= model.openings.filter(o => o.type === 'door').length);
+  assert.equal((svg.match(/data-room-id="room-/g) || []).length, model.rooms.length);
+  assert.ok((svg.match(/data-label-detail="full"/g) || []).length > 0);
+  assert.match(svg, /aria-label="[^"]+ متر مربع/);
+});
+
+test('outline dimension helper includes wall thickness and has a safe rectangle fallback', () => {
+  const model = { building: { x: 0, y: 0, w: 4, h: 5 }, walls: [
+    { type: 'ext', t: .2, x1: .1, y1: .1, x2: 3.9, y2: .1 },
+    { type: 'ext', t: .2, x1: .1, y1: 4.9, x2: 3.9, y2: 4.9 },
+    { type: 'ext', t: .2, x1: .1, y1: .1, x2: .1, y2: 4.9 },
+    { type: 'ext', t: .2, x1: 3.9, y1: .1, x2: 3.9, y2: 4.9 },
+  ] };
+  assert.deepEqual(planOutlineMetrics(model), { minX: 0, maxX: 4, minY: 0, maxY: 5, width: 4, length: 5 });
+  assert.deepEqual(planOutlineMetrics({ building: model.building, walls: [] }), { minX: 0, maxX: 4, minY: 0, maxY: 5, width: 4, length: 5 });
+});
diff --git a/tests/plot-entry.test.mjs b/tests/plot-entry.test.mjs
new file mode 100644
index 0000000..e78a807
--- /dev/null
+++ b/tests/plot-entry.test.mjs
@@ -0,0 +1,175 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { setPlotFromSimpleInput, validateEntryPlot } from '../dist/plot-entry.mjs';
+import { analyzeClientRequest } from '../dist/client-request.mjs';
+import { defaultRooms, generateModel, validatePlot } from '../dist/planner.mjs';
+
+const fresh = () => ({
+  width: 20, length: 30, floors: 1,
+  streets: { n: false, s: true, e: false, w: false }, entry: 's',
+  streetSetback: 3, neighborSetback: 1.5, coverage: .75, maxBuiltArea: null,
+});
+const streetSet = entry => Object.fromEntries(['n', 's', 'e', 'w'].map(side => [side, side === entry]));
+
+function setPlotHarness({ binding = null, explicit = false } = {}) {
+  const state = { streets: { ...fresh().streets }, streetSelectionExplicit: explicit };
+  const fields = { width: 20, length: 30, entry: 's', maxBuiltArea: '' };
+  const events = [];
+  const getRawPlot = () => ({
+    ...fresh(), ...fields, maxBuiltArea: fields.maxBuiltArea === '' ? null : Number(fields.maxBuiltArea),
+    streets: { ...state.streets },
+  });
+  const run = input => setPlotFromSimpleInput({
+    state, input, getRawPlot, getSurveyBinding: () => binding,
+    commitFields(candidate) {
+      events.push('commit');
+      fields.width = candidate.width; fields.length = candidate.length;
+      fields.entry = candidate.entry; fields.maxBuiltArea = candidate.maxBuiltArea ?? '';
+    },
+    renderStreets() { events.push('render'); },
+    rating() { events.push('rating'); },
+    markDirty() { events.push('dirty'); },
+  });
+  return { state, fields, events, getRawPlot, run };
+}
+
+test('the app setPlot API delegates to the tested transactional setter', () => {
+  const source = readFileSync(new URL('../dist/app.mjs', import.meta.url), 'utf8');
+  const methodStart = source.indexOf('  setPlot({ width, length, entry, maxBuiltArea }) {');
+  const methodEnd = source.indexOf('  async propose(', methodStart);
+  assert.notEqual(methodStart, -1);
+  assert.notEqual(methodEnd, -1);
+  assert.match(source.slice(methodStart, methodEnd), /return setPlotFromSimpleInput\(/);
+});
+
+test('advanced street edits and restored project/undo vectors are marked explicit', () => {
+  const source = readFileSync(new URL('../dist/app.mjs', import.meta.url), 'utf8');
+  assert.match(source, /state\.streetSelectionExplicit = true; state\.streets\[b\.dataset\.side\]/);
+  assert.match(source, /restorePlot\(project\.plot, \{ streetSelectionExplicit: true \}\)/);
+  assert.match(source, /restorePlot\(p, \{ streetSelectionExplicit: previous\.streetSelectionExplicit \?\? true \}\)/);
+});
+
+test('the integrated setPlot transaction commits fields and state from the same candidate', () => {
+  const harness = setPlotHarness();
+  const candidate = harness.run({ width: 21, length: 31, entry: 'n', maxBuiltArea: 500 });
+  assert.deepEqual(candidate.streets, streetSet('n'));
+  assert.deepEqual(harness.state.streets, candidate.streets);
+  assert.deepEqual(validatePlot(harness.getRawPlot()), candidate);
+  assert.deepEqual(harness.fields, { width: 21, length: 31, entry: 'n', maxBuiltArea: 500 });
+  assert.deepEqual(harness.events, ['commit', 'render', 'rating', 'dirty']);
+});
+
+test('invalid entry, dimensions, and survey-bound changes leave setPlot state and fields untouched', () => {
+  for (const { input, binding, error } of [
+    { input: { width: 21, length: 30, entry: 'x' }, error: /جهة المدخل غير صالحة/ },
+    { input: { width: 7, length: 30, entry: 'n' }, error: /8 و100/ },
+    {
+      input: { width: 21, length: 30, entry: 'n' },
+      binding: { width: 20, length: 30, source: 'map-estimate' },
+      error: /أبعاد مستطيل المولد مرتبطة بالمسح المحفوظ/,
+    },
+  ]) {
+    const harness = setPlotHarness({ binding });
+    const beforeState = structuredClone(harness.state), beforeFields = structuredClone(harness.fields);
+    assert.throws(() => harness.run(input), error);
+    assert.deepEqual(harness.state, beforeState);
+    assert.deepEqual(harness.fields, beforeFields);
+    assert.deepEqual(harness.events, []);
+  }
+});
+
+test('a changed simple entry replaces only the inferred fresh south frontage', () => {
+  for (const entry of ['n', 'e', 'w']) {
+    const source = { ...fresh(), width: 30, length: 30 }, before = structuredClone({ ...source, streets: { ...source.streets } });
+    const candidate = validateEntryPlot(source, entry, { streetSelectionExplicit: false });
+    assert.equal(candidate.entry, entry);
+    assert.deepEqual(candidate.streets, streetSet(entry));
+    const generated = generateModel(candidate, defaultRooms());
+    assert.equal(generated.plot.entry, entry);
+    assert.deepEqual(generated.plot.streets, streetSet(entry));
+    assert.deepEqual(source, before);
+  }
+  const south = validateEntryPlot(fresh(), 's', { streetSelectionExplicit: false });
+  assert.deepEqual(south.streets, streetSet('s'));
+});
+
+test('advanced explicit multi-street selections survive simple entry changes', () => {
+  const source = { ...fresh(), streets: { n: false, s: true, e: true, w: false } };
+  const candidate = validateEntryPlot(source, 'n', {
+    currentStreets: source.streets,
+    streetSelectionExplicit: true,
+  });
+  assert.deepEqual(candidate.streets, { n: true, s: true, e: true, w: false });
+  assert.equal(candidate.entry, 'n');
+  assert.deepEqual(source.streets, { n: false, s: true, e: true, w: false });
+});
+
+test('advanced explicit single and restored street vectors remain intentional', () => {
+  const current = { n: true, s: false, e: false, w: false };
+  const explicit = validateEntryPlot({ ...fresh(), streets: current }, 'e', {
+    currentStreets: current,
+    streetSelectionExplicit: true,
+  });
+  assert.deepEqual(explicit.streets, { n: true, s: false, e: true, w: false });
+
+  const restored = { n: false, s: true, e: true, w: false };
+  const fromProject = validateEntryPlot({ ...fresh(), streets: restored }, 'e', {
+    currentStreets: restored,
+    streetSelectionExplicit: true,
+  });
+  assert.deepEqual(fromProject.streets, restored);
+});
+
+test('natural-language entry patch reconciles the implicit default before validation', async () => {
+  const sourcePlot = fresh();
+  const proposal = await analyzeClientRequest({
+    prompt: 'أبي ٤ غرف نوم ومجلس وصالة ومطبخ، المدخل شمال',
+    rooms: defaultRooms(), plot: sourcePlot,
+    discovery: { likes: [], rejects: [], avoids: [], life: {} }, mode: 'replace',
+  });
+  assert.equal(proposal.plotPatch.entry, 'n');
+  const merged = { ...sourcePlot, ...proposal.plotPatch };
+  const candidate = validateEntryPlot(merged, merged.entry, {
+    currentStreets: sourcePlot.streets,
+    streetSelectionExplicit: false,
+  });
+  assert.deepEqual(candidate.streets, streetSet('n'));
+
+  const explicitPlot = { ...fresh(), streets: { n: false, s: true, e: true, w: false } };
+  const explicitProposal = await analyzeClientRequest({
+    prompt: 'أبي ٤ غرف نوم ومجلس وصالة ومطبخ، المدخل شمال',
+    rooms: defaultRooms(), plot: explicitPlot,
+    discovery: { likes: [], rejects: [], avoids: [], life: {} }, mode: 'replace',
+  });
+  const explicitMerged = { ...explicitPlot, ...explicitProposal.plotPatch };
+  const explicitCandidate = validateEntryPlot(explicitMerged, explicitMerged.entry, {
+    currentStreets: explicitPlot.streets,
+    streetSelectionExplicit: true,
+  });
+  assert.deepEqual(explicitCandidate.streets, { n: true, s: true, e: true, w: false });
+});
+
+test('invalid plots and survey-bound dimension changes fail without mutating source state', () => {
+  const source = fresh(), before = structuredClone(source);
+  assert.throws(() => validateEntryPlot({ ...source, width: 7 }, 'n'), /8 و100/);
+  assert.deepEqual(source, before);
+
+  assert.throws(() => validateEntryPlot({ ...source, width: 21 }, 'n', {
+    surveyBinding: { width: 20, length: 30, source: 'map-estimate' },
+  }), /أبعاد مستطيل المولد مرتبطة بالمسح المحفوظ/);
+  assert.deepEqual(source, before);
+  const sameBinding = validateEntryPlot(source, 'n', {
+    surveyBinding: { width: 20, length: 30, source: 'map-estimate' },
+  });
+  assert.deepEqual(sameBinding.streets, streetSet('n'));
+  assert.deepEqual(source, before);
+
+  const surveyedFrontage = { ...fresh(), streets: { n: false, s: true, e: true, w: false } };
+  const boundCandidate = validateEntryPlot(surveyedFrontage, 'n', {
+    currentStreets: surveyedFrontage.streets,
+    streetSelectionExplicit: true,
+    surveyBinding: { width: 20, length: 30, source: 'confirmed-edge-references' },
+  });
+  assert.deepEqual(boundCandidate.streets, { n: true, s: true, e: true, w: false });
+});
