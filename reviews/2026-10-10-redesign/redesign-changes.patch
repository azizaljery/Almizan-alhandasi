+// A brief-led compact corridor composition. Rooms remain metric rectangles and are
+// placed on either side of one connected spine; no fixed outer-shape template is
+// inferred from labels. This is a preliminary layout, not an accessibility design.
+import { footprint, normalizeRooms, validatePlot, validateModel, quantities, GEOMETRY, TYPES } from './claude/planner.mjs';
+
+const E = 1e-5, X = GEOMETRY.exterior, T = GEOMETRY.partition, C = GEOMETRY.corridor, B = GEOMETRY.branch;
+const positions = ['front', 'middle', 'back'];
+const near = (a, b) => Math.abs(a - b) < E;
+const uniqueDims = r => {
+  const minimum = TYPES[r.type]?.min ?? 1;
+  const raw = r.dimensions ? [{ w: r.dimensions.width, h: r.dimensions.length }, { w: r.dimensions.length, h: r.dimensions.width }]
+    : [{ w: Math.sqrt(r.area), h: Math.sqrt(r.area) }];
+  return raw.filter((d, i) => d.w >= minimum - E && d.h >= minimum - E
+    && (i === 0 || !near(d.w, raw[0].w) || !near(d.h, raw[0].h)));
+};
+const stateKey = s => ['left', 'right'].flatMap(side => s[side].map(r => `${r.id}:${r.w}x${r.h}`)).join('|');
+
+function zoneOptions(roomList) {
+  let beam = [{ left: [], right: [] }];
+  for (const room of roomList) {
+    const sides = room.side === 'any' ? ['left', 'right'] : [room.side];
+    const expanded = [];
+    for (const s of beam) for (const side of sides) for (const d of uniqueDims(room)) {
+      const next = { left: [...s.left], right: [...s.right] };
+      next[side].push({ ...room, w: d.w, h: d.h, resolvedSide: side }); expanded.push(next);
+    }
+    const score = s => {
+      const sw = side => Math.max(0, ...s[side].map(r => r.w));
+      const sh = side => s[side].reduce((n, r) => n + r.h + T, 0);
+      const depth = Math.max(sh('left'), sh('right'));
+      const width = sw('left') + sw('right') + C + 2 * T + 2 * X;
+      const reserve = sw('left') * Math.max(0, depth - sh('left')) + sw('right') * Math.max(0, depth - sh('right'));
+      return width * (depth + 2 * X) + reserve * .55 + C * depth * .25;
+    };
+    const dedupe = new Map();
+    for (const s of expanded.sort((a, b) => score(a) - score(b) || stateKey(a).localeCompare(stateKey(b)))) {
+      const k = stateKey(s); if (!dedupe.has(k)) dedupe.set(k, s);
+    }
+    beam = [...dedupe.values()].slice(0, 72);
+  }
+  return beam.map(s => ({ left: s.left, right: s.right,
+    leftDepth: s.left.reduce((n, r) => n + r.h + T, 0) - (s.left.length ? T : 0),
+    rightDepth: s.right.reduce((n, r) => n + r.h + T, 0) - (s.right.length ? T : 0),
+  }));
+}
+
+function mapper(plot, f) {
+  const point = (x, y) => plot.entry === 's' ? { x: f.x + x, y: f.y + y }
+    : plot.entry === 'n' ? { x: f.x + f.w - x, y: f.y + f.h - y }
+      : plot.entry === 'e' ? { x: f.x + f.w - y, y: f.y + x }
+        : { x: f.x + y, y: f.y + f.h - x };
+  const rect = r => { const a = point(r.x, r.y), b = point(r.x + r.w, r.y + r.h); return { ...r,
+    x: Math.min(a.x, b.x), y: Math.min(a.y, b.y), w: Math.abs(b.x - a.x), h: Math.abs(b.y - a.y) }; };
