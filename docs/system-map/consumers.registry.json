{
  "schemaVersion": "1.1.0",
  "consumers": [
    {
      "consumerId": "aziz-engine",
      "reads": [
        "candidate.identity",
        "candidate.geometryHash",
        "hardConstraintResults",
        "scoreVector",
        "scoreConfidence",
        "evidenceCoverage"
      ],
      "writes": [
        "decisionId",
        "decisionStatus",
        "selectedCandidateIds",
        "decisionTrace",
        "refinementRequests"
      ],
      "mustNotWrite": [
        "scoreAxisDefinitions",
        "candidateNativeGeometry",
        "evidenceRecords"
      ],
      "fallbackPolicy": "NO_SELECTION",
      "verification": "UNKNOWN",
      "evidenceIds": []
    },
    {
      "consumerId": "mizan-score",
      "reads": [
        "model",
        "auditReview",
        "quantities"
      ],
      "writes": [
        "score",
        "normalized",
        "grade",
        "confidence",
        "axes",
        "strengths",
        "improvements",
        "penalties",
        "note"
      ],
      "mustNotWrite": [
        "selectedCandidateId",
        "winner",
        "candidateNativeGeometry"
      ],
      "fallbackPolicy": "RETURN_NULL_WHEN_NO_MODEL",
      "verification": "INFERRED",
      "evidenceIds": []
    },
    {
      "consumerId": "renderer-2d",
      "reads": [
        "model.plot",
        "model.building",
        "model.footprint",
        "model.rooms",
        "model.corridors",
        "model.reserves",
        "model.walls",
        "model.openings"
      ],
      "writes": [
        "svgOutput"
      ],
      "mustNotWrite": [
        "canonicalGeometry"
      ],
      "fallbackPolicy": "UNKNOWN",
      "verification": "VERIFIED_TEST",
      "evidenceIds": [
        "EVD-TEST-0001"
      ]
    },
    {
      "consumerId": "renderer-3d",
      "reads": [
        "model.plot",
        "model.building",
        "model.rooms",
        "model.corridors",
        "model.walls",
        "model.openings"
      ],
      "writes": [
        "threeScene"
      ],
      "mustNotWrite": [
        "canonicalGeometry"
      ],
      "fallbackPolicy": "DISPLAY_ERROR_WHEN_WEBGL_UNAVAILABLE",
      "verification": "VERIFIED_TEST",
      "evidenceIds": [
        "EVD-TEST-0001"
      ]
    },
    {
      "consumerId": "boq-engine",
      "reads": [
        "model",
        "planner.quantities(model)",
        "model.openings"
      ],
      "writes": [
        "quantityRows",
        "estimateTotals"
      ],
      "mustNotWrite": [
        "canonicalGeometry"
      ],
      "fallbackPolicy": "FAIL_ON_INVALID_COST_INPUTS",
      "verification": "VERIFIED_TEST",
      "evidenceIds": [
        "EVD-TEST-0001"
      ]
    }
  ]
}