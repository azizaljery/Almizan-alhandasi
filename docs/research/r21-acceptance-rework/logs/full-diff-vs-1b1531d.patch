+    const B = bbox(poly), A = SHOWER_RULE.access, sides = [{ x0: B.x0, x1: B.x1, y0: B.y0 - A, y1: B.y0 }, { x0: B.x0, x1: B.x1, y0: B.y1, y1: B.y1 + A }, { x0: B.x0 - A, x1: B.x0, y0: B.y0, y1: B.y1 }, { x0: B.x1, x1: B.x1 + A, y0: B.y0, y1: B.y1 }];
