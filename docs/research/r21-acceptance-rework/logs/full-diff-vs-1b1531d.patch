+export const SHOWER_RULE = Object.freeze({ access: 0.7, source: 'قيم تصميمية افتراضية للميزان (مسقط الوصول 0.7 م) وحد العرض الصافي المرشح في plan-review.mjs — غير متحققة من كود صحي' });
