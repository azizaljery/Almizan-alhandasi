+  const win = { a: { x: 0, y: -1 }, b: { x: 0, y: 1 }, sillHeight: 0.5, headHeight: 2.2 }, eyes = { outside: [1.2, 1.6], inside: [1.1, 1.6] };
+  const base = { window: win, parkingPoints: [{ x: 5, y: 0 }], interiorPoints: [{ x: -3, y: 0 }], eyes };
