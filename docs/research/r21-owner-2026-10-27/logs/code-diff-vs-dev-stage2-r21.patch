+  const m1 = calculateMizanScore(docToLegacy(withFence, { level: 'L1' }).model), m0 = calculateMizanScore(docToLegacy(without, { level: 'L1' }).model);
+  const comp = m1.axes.find(a => a.key === 'compliance');
