+// (الجولة 21 — المراجعة العمياء r20: «لغة داخلية في الإشعارات»: «المقياس الوظيفي v2»، «بعد جوهري»، «شكل U/L/H»، «مخالفة إلزامية في الميزان»،
+// «يُعفى منه بطلب صريح»، «شبكة 4×3»، «القيود الصلبة»، «المولّد») كل نص يراه العميل يمر بهذا المحوّل: يُعاد صوغ العبارات الداخلية
+// المعروفة بعربية واضحة، وتُحذف الرموز الداخلية. وقائمة المصطلحات الممنوعة (BANNED_CLIENT_TERMS) يفحص بها اختبار كل نص عميل.
+// وحدة نقية بلا DOM ولا اعتماد على حالات بعينها.
+
+/** المصطلحات الممنوعة في نص العميل بعد التحويل: [نمط، سبب]. */
+export const BANNED_CLIENT_TERMS = Object.freeze([
+  [/المقياس الوظيفي|\bv[123]\b/, 'اسم مقياس أو إصدار داخلي'],
+  [/بعد(?:ان)? جوهري|بعدان جوهريان|أبعاد جوهرية/, 'مصطلح مقياس الاختلاف الداخلي'],
+  [/شكل\s*[«"]?[ULHT]\b|«شكل [A-Z]/, 'اسم نمط داخلي بحرف لاتيني'],
+  [/مخالفة إلزامية في الميزان|شرط إلزامي في الميزان/, 'تسمية طبقة تقييم داخلية'],
+  [/يُعفى منه|يعفى منه/, 'لغة إعفاء داخلية'],
+  [/شبكة\s*\d+\s*[×x]\s*\d+|القيود الصلبة|القيد الصلب/, 'مصطلح بحث القيود الداخلي'],
+  [/المولّد|المولد\b|التلدين|الشجرة المقصلية|أشجار التقسيم/, 'اسم مكوّن برمجي'],
+  [/البوابات الثقيلة|بوابات الجودة|بوابة المراجعة|رسب في بوابة/, 'اسم فحص داخلي'],
+  [/قرار المالك|توجيه المالك/, 'إشارة إلى قرارات داخلية'],
+  [/نسخة معدّلة|نسخ معدّلة|تبادل موضعي|النمط ذاته|الأنماط المرشحة|أنماط تنظيمية|المرشحون المبنيون/, 'مصطلح اختيار داخلي'],
+  [/\b[A-Z][A-Z0-9]*_[A-Z0-9_]+\b/, 'رمز قياس داخلي'],
+  [/\b(?:alt|opt)-\w+|\.(?:json|mjs|png)\b/i, 'معرّف ملف'],
+  [/\b[a-z]{3,}:[a-z]{1,5}\d[a-z0-9]*\b/i, 'معرّف تنظيم داخلي'],
+  // (مقترح — kit results.mjs lintClientText) مصطلحات المحرك والاستثناءات
+  [/\b(?:CSP|hardLink|R14_OFF|TypeError|ReferenceError|VILLA_[A-Z_]+|__v2\w*)\b/, 'مصطلح أو استثناء برمجي'],
+  [/شجرة تقسيم|خطأ داخلي|رمز الاستثناء|Cannot read|undefined|null\b/i, 'نص استثناء داخلي'],
+]);
+/** (kit lintClientText) بالإضافة إلى قائمة المصطلحات الموجودة لا بدلًا منها. */
+export const lintClientText = text => clientLint(text).map(x => x.match);
+
+/** (الجولة 21) أسماء فحوص المراجعة بعربية العميل (كان يظهر الرمز الداخلي: «رسب في بوابة المراجعة PARKING»). */
+export const GATE_AR = Object.freeze({ BED_MAJLIS: 'فصل غرف النوم عن المجلس', COVERAGE: 'نسبة البناء', DAYLIGHT: 'الإضاءة الطبيعية', DOOR_SWING: 'حركة فتح الأبواب', GUEST_ROUTE: 'مسار الضيف',
+  HALL_ASPECT: 'تناسب الصالة', INTEGRITY: 'سلامة الرسم', MAJLIS_PRIVACY: 'خصوصية المجلس', MIN_WIDTH: 'أدنى عرض للفراغات', PLACEMENT: 'مواضع الفراغات المطلوبة', PLOT: 'حدود الأرض',
+  PROGRAM: 'اكتمال البرنامج', REACH: 'الوصول إلى كل الفراغات', SETBACK_REG: 'الارتدادات النظامية', STAIRS: 'الدرج', STAIR_GEOMETRY: 'أبعاد الدرج', WET_DOOR: 'أبواب دورات المياه', WINDOW_SIZE: 'مساحة النوافذ',
+  PARKING: 'مواقف السيارات', STRUCTURAL: 'المراجعة الإنشائية المبدئية', CIRCULATION: 'الحركة الفعلية مع الأثاث', CONSISTENCY_2D3D: 'تطابق المسقط والمجسم' });
+// إعادة الصوغ: الأطول أولًا (العبارات الكاملة قبل أجزائها)
+const REWRITE = [
+  // أسباب النقص (shortfallReason)
+  [/المرشحون المبنيون من أنماط تنظيمية مختلفة (\d+)، اجتاز البوابات منهم (\d+)/g, (_, a, b) => `جرّبتُ ${a} ${+a >= 3 && +a <= 10 ? 'تنظيمات مختلفة' : 'تنظيمًا مختلفًا'} للبيت، اجتاز الفحص منها ${b}`],
+  [/(\d+) نسخة معدّلة من بديل معروض \(لا بعد جوهري في المقياس الوظيفي v2: موضع السلم أو الغلاف أو مقاسات فقط\)/g, (_, n) => `${n} ${+n === 1 ? 'تصميم يكاد يطابق تصميمًا معروضًا' : 'تصاميم تكاد تطابق تصاميم معروضة'} (يختلف في موضع الدرج أو حدود المبنى أو المقاسات فقط)`],
+  [/(\d+) اختلافها عن بديل معروض جزئي \(بعد جوهري واحد فقط من توزيع الوظائف والحركة والخصوصية والعلاقات؛ المطلوب بعدان\)/g, (_, n) => `${n} ${+n === 1 ? 'تصميم يختلف' : 'تصاميم تختلف'} عن المعروض في جانب واحد فقط (توزيع الوظائف أو الحركة أو الخصوصية)، وأعرض فقط ما يختلف في جانبين على الأقل`],
+  [/(\d+) تنويع على تنظيم معروض نفسه \(النمط ذاته بتبادل موضعي\)/g, (_, n) => `${n} ${+n === 1 ? 'تصميم هو التصميم المعروض نفسه' : 'تصاميم هي التصاميم المعروضة نفسها'} مع تبديل موضع غرفتين`],
+  [/(\d+) رسبت في البوابات الثقيلة \(([^)]*)\)/g, (_, n, w) => `${n} لم ${+n === 1 ? 'يجتز' : 'تجتز'} فحص ${w.replace(/\s*\d+/g, '').replace(/،\s*/g, ' و')}`],
+  [/ورُفض (\d+) في بوابات الجودة والسلامة/g, (_, n) => `ولم ${+n === 1 ? 'يجتز تصميم واحد' : `يجتز ${n}`} فحوص الجودة والسلامة`],
+  [/رُفض (\d+) في المراجعة المعمارية المستقلة \([A-Z_،, ]+\)/g, (_, n) => `لم ${+n === 1 ? 'يجتز تصميم واحد' : `يجتز ${n}`} المراجعة المعمارية`],
+  [/المراجعة المعمارية المستقلة \([A-Z_،, ]+\)/g, 'المراجعة المعمارية'],
+  [/لا يُكمَّل العدد بنسخ معكوسة أو شكلية ولا ببديل يخالف شرطًا إلزاميًا \(قرار المالك\)\.?/g, 'لم أُكمل العدد بنسخ معكوسة أو متشابهة ولا بتصميم يخالف شرطًا أساسيًا.'],
+  [/(\d+) لم تدخل مجموعة تحقق أدنى اختلاف مع كل البدائل المعروضة معًا/g, (_, n) => `${n} لا ${+n === 1 ? 'يختلف' : 'تختلف'} بما يكفي عن كل التصاميم المعروضة معًا`],
+  // طبقات التقييم
+  [/مخالفة إلزامية في الميزان\s*—\s*/g, 'شرط أساسي غير متحقق: '],
+  [/مخالفة إلزامية في الميزان/g, 'شرط أساسي غير متحقق'],
+  [/\(شرط إلزامي في الميزان(?: \([^)]*\))?\s*—\s*يُعفى منه بطلب صريح[^)]*\)/g, '(شرط أساسي في تصميم البيت السعودي، ويمكنك طلب غيره صراحةً)'],
+  [/شرط إلزامي في الميزان(?: \([^)]*\))?/g, 'شرط أساسي في تصميم البيت السعودي'],
+  [/يُعفى منه بطلب صريح[^،.)]*/g, 'ويمكنك طلب غيره صراحةً'],
+  // أسماء الأنماط بحرف لاتيني
+  [/«?شكل ([ULHT])(?: خلفي)?»?\s*:\s*/g, ''],
+  [/\(«شكل [A-Z][^»]*»(?:، «[^»]*»)*\)/g, ''],
+  [/«شكل [A-Z][^»]*»/g, 'هذا التنظيم'],
+  // بحث القيود الداخلي
+  [/جُرّبت شبكة[^.\n]*\./g, ''],
+  [/السبب من المولّد:\s*/g, ''],
+  [/من الأنماط المرشحة/g, 'ضمن التنظيمات التي جرّبتها'],
+  [/البوابات الثقيلة \(([^)]*)\)/g, 'الفحوص المفصّلة ($1)'],
+  [/البوابات الثقيلة/g, 'الفحوص المفصّلة'],
+  [/بوابات الجودة والسلامة/g, 'فحوص الجودة والسلامة'],
+  [/رسب في بوابة المراجعة\s+([A-Z_0-9]+)/g, (_, g) => `لم يجتز فحص «${GATE_AR[g] || 'المراجعة المعمارية'}»`],
+  [/\(قرار المالك\)/g, ''],
+  [/المولّد|المولد\b/g, 'المحرك'],
+  [/القيود الصلبة/g, 'الشروط الأساسية'],
+  [/المقياس الوظيفي v2/g, 'مقياس الاختلاف الوظيفي'],
+  [/التطابق 2D\/3D/g, 'تطابق المسقط والمجسم'],
+];
+
+/** يحوّل نصًا داخليًا إلى عربية العميل (لا يغيّر الأرقام ولا الأسماء العربية). */
+export function toClientAr(text) {
+  if (text == null) return text;
+  let s = String(text);
+  for (const [re, rep] of REWRITE) s = s.replace(re, rep);
+  // الرموز الداخلية الباقية (MAJLIS_ISOLATED…) تُحذف بأقواسها إن كانت وحدها بين قوسين
+  s = s.replace(/\s*\((?:[A-Z][A-Z0-9]*_[A-Z0-9_]+[،, ]*)+\)/g, '').replace(/\b[A-Z][A-Z0-9]*_[A-Z0-9_]+\b/g, '');
+  return s.replace(/[ \t]{2,}/g, ' ').replace(/\s+([.،؛])/g, '$1').replace(/؛\s*؛/g, '؛').replace(/^\s*[؛،]\s*/, '').trim();
+}
+/** المصطلحات الممنوعة الباقية في نص (بعد التحويل أو قبله): [{ match, why }]. */
+export function clientLint(text) {
+  const s = String(text ?? ''), out = [];
+  for (const [re, why] of BANNED_CLIENT_TERMS) { const m = re.exec(s); if (m) out.push({ match: m[0], why }); }
+  return out;
+}
+export default { BANNED_CLIENT_TERMS, GATE_AR, toClientAr, clientLint };
