+  let o = null, e = null; try { o = V3.generateVillaDesigns({ land, counts: r.counts, requirements: r, keep: C.want || r.want || 4 }); } catch (x) { e = x; }
+  const v = { C, r, land, o, e }; memo.set(k, v); return v;
