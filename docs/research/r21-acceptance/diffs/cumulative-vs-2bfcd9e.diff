+// ------------------------------------------------------------------ (أ) عقد الحزمة: clear-dimensions
+test('02c الحزمة: 4×5 «بالضبط» ينجح، وناقص 4 سم يرسب بالضبط وينجح بلا وصف، و«تقريبًا» ±0.30', () => {
