+const rect = (w, h, x = 0, y = 0) => [{ x, y }, { x: x + w, y }, { x: x + w, y: y + h }, { x, y: y + h }];
+const M = (net, want, tol, o = {}) => measureClearDims({ net, holes: o.holes || [] }, want, tol, o);
